
; --- Dental Clinic offline overrides ---
extension_dir = "__EXT_DIR__"
extension=curl
extension=fileinfo
extension=gd
extension=intl
extension=mbstring
extension=openssl
extension=pdo_mysql
extension=mysqli
extension=sodium
extension=zip
extension=exif
; Windows PHP ships no CA list; without one every HTTPS call (activation) fails.
curl.cainfo = "__CA_FILE__"
openssl.cafile = "__CA_FILE__"
memory_limit = 512M
upload_max_filesize = 64M
post_max_size = 64M
max_execution_time = 300
date.timezone = Asia/Baghdad
opcache.enable_cli = 0
zend_extension=opcache
opcache.enable = 1
opcache.memory_consumption = 256
opcache.max_accelerated_files = 20000

; Only Caddy on this computer talks to the workers.
cgi.force_redirect = 0
cgi.fix_pathinfo = 1
