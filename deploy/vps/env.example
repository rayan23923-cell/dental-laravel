# Copy to the repo root on the VPS as `.env` and fill in the blanks (never commit the real one).
APP_NAME="Dental Clinic"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dental.azoclinic.duckdns.org
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dental
DB_USERNAME=dental
DB_PASSWORD=
# Used only by the MySQL container on first start.
DB_ROOT_PASSWORD=

# Files instead of the database: one server, and it keeps a DB write off every web request.
SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@azoclinic.duckdns.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
